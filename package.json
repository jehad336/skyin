{
  "name": "skyin",
  "private": true,
  "description": "Skyin Travel & Tourism — website, customer accounts, bookings and payments (Arabic, RTL)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=server server/index.js",
    "start": "node server/index.js",
    "db:up": "docker compose up -d db",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "create-admin": "node server/create-admin.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "build:html": "python _build/build.py",
    "build:css": "tailwindcss -c src/tailwind.config.js -i src/input.css -o public/assets/skyin.css --minify",
    "build": "npm run build:html && npm run build:css",
    "db:local": "node scripts/dev-db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17"
  }
}
