# Copy to .env for local development.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://skyin:skyin@localhost:5433/skyin

# Payments: "mock" = local test gateway (no keys, no money). "moyasar" = real gateway.
PAYMENT_PROVIDER=mock
# Moyasar dashboard → Settings → API keys. Use sk_test_… until you go live.
MOYASAR_SECRET_KEY=
# Any long random string; added to the callback URL Moyasar calls.
PAYMENT_WEBHOOK_KEY=
